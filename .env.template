# Copy to .env (gitignored, never committed) and fill in real values.
# infrastructure.database.make_engine() loads this via python-dotenv,
# searching upward from this process's cwd -- run uvicorn/NSSM with this
# repo's directory as the working directory so it's found.

DB_URL=postgresql+psycopg2://examplelab:changeme@localhost:5432/report_engine

# Shared-secret auth for /generate-report and /refresh-cache (checked via
# the X-API-Key request header). Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset to skip auth entirely (local dev only -- see app.py AUTH).
API_KEY=changeme

# When set, confines every report-folder mapping under this directory
# (auto-created on demand) instead of anywhere on disk -- lets Jamie and
# Quality exercise the real customer/chemical/folder resolution + save +
# workbook-swap flow end-to-end with zero possibility of a write landing
# in a real customer's real S:\Reports folder. Unset (the default)
# means production mode -- confined to REPORT_FOLDER_ROOT below instead,
# not unrestricted. A "TEST MODE" banner appears on every browser
# resolution page while this is set, and /health and /generate-report
# both report it via a `test_mode` field.
# Point this at a real shared folder Quality can reach themselves,
# rather than somewhere local to whichever PC hosts the service (e.g.
# S:\Quality_Items\Macro Validation\SLIM Report Engine v1.0.0) -- a
# drive-letter path here goes through the same resolve_mapped_drive()
# UNC translation as REPORT_FOLDER_ROOT/TESTING_REQUESTS_ROOT below, so
# it works from the service the same way it does interactively.
# REPORT_FOLDER_TEST_ROOT=C:\SlimLimsTestOutput

# Production-mode folder containment: /resolve/folder (reachable via a
# one-time token, NOT the API key) can only set a customer's report
# destination to somewhere under this directory -- without it, any
# existing absolute directory the server can see would be accepted.
# Ignored when REPORT_FOLDER_TEST_ROOT is set. Defaults to the real
# S:\Reports if left unset -- only override this for a non-standard
# deployment.
# REPORT_FOLDER_ROOT=S:\Reports

# /generate-report only accepts an input_path under this directory --
# without it, anyone with the API key could ask the server to try to
# open any path it can read. Defaults to the real S:\Testing_Requests
# if left unset -- only override this for a non-standard deployment.
# TESTING_REQUESTS_ROOT=S:\Testing_Requests

# Confirmed real (2026-09-22): a Windows Service -- even one running
# under a real interactive user's own account -- does NOT see that
# account's mapped network drives (S:\, etc.). Drive mappings belong to
# the interactive logon session that created them, not the account
# itself, so a background service gets a separate session where the
# mapping simply doesn't exist. VBA always sends whatever
# ActiveWorkbook.FullName resolves to on the technician's machine --
# always a drive-letter path -- so without this, every real request
# 404s once this runs as a service. Set to the real UNC path `net use`
# shows for that drive letter; format is MAPPED_DRIVE_<LETTER>_UNC.
# A leading S:\ (or s:\) in any incoming path, or in
# TESTING_REQUESTS_ROOT/REPORT_FOLDER_ROOT above, is rewritten to this
# before any filesystem access -- see infrastructure/network_paths.py
# (slim-domain) for the actual translation.
MAPPED_DRIVE_S_UNC=\\LAB-SERVER\LabShare
