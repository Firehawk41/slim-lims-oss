# development | production (production requires SECRET_KEY and sends HSTS + Secure cookies)
APP_ENV=development
SECRET_KEY=
# One Postgres shared with the SLIM ecosystem; SQLite works for quick local runs.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/slim
# SLIM reference tables (customers, chemicals, elements, analyses). Defaults to DATABASE_URL.
# Use the OSS demo data (scripts/seed_demo.py) -- never point a dev setup at the lab's database.
# SLIM_DATABASE_URL=
# REFERENCE_CACHE_TTL_SECONDS=300
# OSS ONLY: only localhost/127.0.0.1/db/postgres (and SQLite) are allowed. List any other DEMO
# database host here (comma-separated). URLs containing "precilab" are always refused.
# PORTAL_ALLOWED_DB_HOSTS=
# Bearer token for slim-lims (docs/SLIM_DOMAIN_V2.md §12), >= 32 chars; unset = no machine access.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# LIMS_API_TOKEN=
# Public demo sandbox only: "Continue as..." personas (data/demo_personas.csv), recorded as ASSERTED.
# DEMO_PERSONAS=false
# The lab's local time zone ("today" for expected-arrival and receipt dates)
# LAB_TIMEZONE=America/Chicago
# Optional overrides
# SESSION_COOKIE_SECURE=true
# SESSION_MAX_AGE_SECONDS=28800
# MAX_BODY_BYTES=1048576
